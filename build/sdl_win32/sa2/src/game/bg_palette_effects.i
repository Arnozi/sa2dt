void BgPaletteEffectGradient(int_vcount vcount)
{
    BgPaletteEffectState *state = gBgPaletteEffects.state;

    if (vcount >= (240 - 1)) {
        state->cursor = 0;
        return;
    }

    if (vcount < state->pattern[state->cursor] + state->offset) {
        return;
    }

    CpuFastSet(&state->palette[state->cursor * 16], (u16 *)((u16*)&PLTT[0]) + (state->bgPalId * 16), ((sizeof(u16) * 2)/(32/8) & 0x1FFFFF));

    state->cursor++;
}

